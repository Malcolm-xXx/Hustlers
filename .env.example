# App environment
ENV=development
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/mydatabase
POSTGRES_DB=hustlers_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Auth
JWT_SECRET_KEY=dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_OTP_EXPIRE_MINUTES=15
PASSWORD_RESET_OTP_EXPIRE_MINUTES=15

# Email
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Images
IMAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth / integrations
GOOGLE_CLIENT_IDS=[]
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GEOAPIFY_API_KEY=your_geoapify_api_key_here
DEFAULT_PLACES_PROVIDER=geoapify
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret
SENTRY_DSN=https://xxx@o4510417231282176.ingest.us.sentry.io/4511278524334080

# Realtime
ABLY_API_KEY=your_ably_root_key
ABLY_SUBSCRIBE_KEY=your_ably_subscribe_key

# Logging
LOG_LEVEL=INFO
JSON_LOGS=true
FILE_LOG_MAX_BYTES=10485760
FILE_LOG_BACKUP_COUNT=5
